rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // পাবলিক রিড (অভিভাবকদের রেজাল্ট অনুসন্ধান ও প্রাথমিক কনফিগারেশন)
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /results/{resId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // লগইনকৃত ব্যবহারকারী (অ্যাডমিন ও শিক্ষক) - শিক্ষার্থী ও নম্বর এন্ট্রি
    match /users/{uid} {
      allow read, write: if request.auth != null;
    }
    match /students/{sid} {
      allow read, write: if request.auth != null;
    }
    match /marks/{markId} {
      allow read, write: if request.auth != null;
    }

    // ডিফল্ট সিকিউরিটি: লগইন করা থাকলে অনুমতি, অন্যথায় নিষেধ
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
